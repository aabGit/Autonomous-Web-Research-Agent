# Copy this file to .env and fill in what you have.
# The agent can run with DuckDuckGo search and no paid keys,
# but you need at least one LLM provider.

# --- LLM layer (pick one) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Ollama (local daemon, or cloud at https://ollama.com):
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=gpt-oss:20b
# OLLAMA_API_KEY=
# OLLAMA_HOST=
# OLLAMA_HOST=https://ollama.com

# Azure OpenAI (LLM_PROVIDER=azure)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com/
# AZURE_OPENAI_DEPLOYMENT=
# AZURE_OPENAI_API_VERSION=2024-10-21

# Amazon Bedrock chat (LLM_PROVIDER=bedrock). Uses standard AWS env vars
# for credentials. This is inference only — not SageMaker training.
# BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Optional better web search ---
# TAVILY_API_KEY=

# --- LangSmith (observability, Phase 2) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=autonomous-web-research-agent

# --- RAG ---
# auto = Pinecone when PINECONE_API_KEY is set, else local Chroma
VECTOR_DB=auto
PINECONE_API_KEY=
PINECONE_INDEX=research-memory
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
PINECONE_EMBED_MODEL=llama-text-embed-v2
CHROMA_PATH=.chroma
CHROMA_COLLECTION=research_memory
MAX_RESEARCH_LOOPS=1
SEARCH_RESULTS_PER_QUERY=2
MAX_PAGES_PER_RUN=6
