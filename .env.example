# Copy this file to .env and fill in what you have.
# The agent can run with DuckDuckGo search and no paid keys,
# but you need at least one LLM provider.

# --- LLM layer (pick one) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Ollama local fallback:
# LLM_PROVIDER=ollama
# OLLAMA_MODEL=llama3.1

# --- Optional better web search ---
# TAVILY_API_KEY=

# --- LangSmith (observability, Phase 2) ---
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=autonomous-web-research-agent

# --- RAG ---
CHROMA_PATH=.chroma
CHROMA_COLLECTION=research_memory
MAX_RESEARCH_LOOPS=3
